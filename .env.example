NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public base URL of the site (used in e-mailed links). Required in production.
NEXT_PUBLIC_SITE_URL=

# Online payment (optional). Empty = feature off: no screen changes and the notice route answers 404.
# Name of a provider registered in src/lib/pagamento-online/pagamentoOnline.ts (none yet).
PAGAMENTO_ONLINE_PROVEDOR=
# Server-only key used to confirm a paid charge from the provider's notice. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (optional). Empty = feature off: no screen changes and the notice route answers 404.
# Name of a provider registered in src/lib/whatsapp/whatsapp.ts (none yet). Uses SUPABASE_SERVICE_ROLE_KEY above.
WHATSAPP_PROVEDOR=
# Local tests only: "1" turns on a fake sending provider for the inbox (ignored unless Supabase is localhost).
# WHATSAPP_FALSO_LOCAL=

# Reminders clock (R132): GET /api/lembretes/relogio with "Authorization: Bearer <CRON_SECRET>", every 5 minutes.
# At least 16 characters; without it the route answers 401. Uses SUPABASE_SERVICE_ROLE_KEY above.
CRON_SECRET=
